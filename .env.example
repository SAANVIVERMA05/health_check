# Backend database connection. Replace the placeholders locally; do not commit your .env file.
DATABASE_URL=postgresql+psycopg2://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# Used by docker compose for local PostgreSQL only
POSTGRES_DB=YOUR_DB_NAME
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_LOCAL_DB_PASSWORD

# API base URL used when building the frontend
VITE_API_URL=http://localhost:8000/api

# Backend-backed profile shown on the landing page during the demo
VITE_DEMO_EMAIL=hr.demo@example.com

# Comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000